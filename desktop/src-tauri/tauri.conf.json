{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenEvo Desktop",
  "version": "0.1.8",
  "identifier": "org.openevo.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:openevo",
    "beforeBundleCommand": "npm run generate:icons",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:openevo"
  },
  "app": {
    "windows": [
      {
        "title": "OpenEvo Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.icns"],
    "externalBin": [
      "binaries/openevo-desktop-sidecar",
      "binaries/openevo-ssh-askpass"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
