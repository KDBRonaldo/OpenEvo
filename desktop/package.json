{
  "name": "openevo-desktop",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite --mode openevo-self-hosted-webui",
    "dev:agent:webui:remote": "uv run openevo webui",
    "dev:agent:webui:status": "uv run openevo webui --status",
    "dev:agent:webui:logs": "uv run openevo webui --logs",
    "dev:agent:webui:stop": "uv run openevo webui --stop",
    "build": "vite build --mode openevo-self-hosted-webui",
    "build:webui-gateway": "vite build --mode openevo-self-hosted-webui --base / --outDir ../src/openevo/web_gateway/static && node scripts/verify-webui-gateway-build.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:webui:e2e": "playwright install chromium && playwright test --config playwright.development-agent.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
