{
  "name": "openevo-desktop",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode openevo-live-agent --open /product-preview.html",
    "dev:agent:remote": "python3 ../scripts/dev/run_remote_agent_development.py",
    "dev:agent:web:remote": "uv run python ../scripts/dev/run_remote_agent_development.py --web-layer",
    "dev:agent:webui:remote": "uv run python ../scripts/dev/run_remote_agent_development.py --self-hosted-webui",
    "dev:agent:web": "vite --mode openevo-live-agent-web",
    "dev:live": "uv run python ../scripts/dev/run_desktop_live.py",
    "dev:formal": "uv run python ../scripts/dev/run_desktop_live.py --prepare",
    "dev:formal:browser": "uv run python ../scripts/dev/run_desktop_live.py --prepare --browser",
    "dev:openevo": "vite --mode openevo-desktop",
    "build": "vite build",
    "build:openevo": "vite build --mode openevo-desktop && node scripts/package-openevo-product.mjs",
    "build:webui-gateway": "vite build --mode openevo-self-hosted-webui --base / --outDir ../src/openevo/web_gateway/static && node scripts/verify-webui-gateway-build.mjs",
    "generate:icons": "bash src-tauri/icons/generate-icons.sh",
    "check:icons": "bash src-tauri/icons/generate-icons.sh --check",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:sidecar": "python packaging/build_sidecar.py",
    "build:desktop": "npm run build:sidecar && npm run tauri:build",
    "preview": "vite preview",
    "test": "vitest",
    "test:agent:web:e2e": "playwright install chromium && playwright test --config playwright.development-agent.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
